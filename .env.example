# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# LTA_DATAMALL_ACCOUNT_KEY: Required for LTA DataMall real-time CarParkAvailabilityv2 API calls.
# Request your free key at: https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
# All requests to https://datamall2.mytransport.sg/ltaodataservice/CarParkAvailabilityv2 require AccountKey header.
LTA_DATAMALL_ACCOUNT_KEY="YOUR_LTA_DATAMALL_ACCOUNT_KEY"

# ONEMAP Credentials: Used to automatically request and renew 72-hour access tokens from OneMap (SLA).
# Register for free at: https://www.onemap.gov.sg/apidocs/register
ONEMAP_EMAIL="YOUR_ONEMAP_EMAIL"
ONEMAP_PASSWORD="YOUR_ONEMAP_PASSWORD"
